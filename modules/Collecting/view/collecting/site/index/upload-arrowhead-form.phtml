        <?php if ($result): ?>
            <div class="result-message">
                <?php echo $this->escapeHtml($result); ?>
            </div>
        <?php endif; ?>
    </div>
<?php endif; ?>

<?php echo $this->form()->openTag($form); ?>

<input type="hidden" name="upload_type" value="<?php echo $this->escapeHtml($formType); ?>">

