# ========================================================================================
# MIXED EXCAVATION AND ITEMS DATA - MONTE DA PENHA ARCHAEOLOGICAL SITE
# ========================================================================================

# =========== MAIN EXCAVATION ===========

<https://purl.org/megalod/excavation/monte-da-penha-2023> a excav:Excavation ;
    dct:identifier "MDP-2023"^^xsd:literal ;
    dul:hasLocation <https://purl.org/megalod/location/monte-da-penha> ;
    excav:hasPersonInCharge <https://purl.org/megalod/archaeologist/joao-silva> ;
    excav:hasSquare <https://purl.org/megalod/square/C1>, 
                    <https://purl.org/megalod/square/C2>,
                    <https://purl.org/megalod/square/D1> ;
    excav:hasContext <https://purl.org/megalod/context/CTX-101>,
                     <https://purl.org/megalod/context/CTX-102>,
                     <https://purl.org/megalod/context/CTX-103> .

# =========== LOCATION ===========

<https://purl.org/megalod/location/monte-da-penha> a excav:Location ;
    dbo:informationName "Monte da Penha Archaeological Site"^^xsd:literal ;
    dbo:district <http://dbpedia.org/resource/Braga> ;
    dbo:parish <http://dbpedia.org/resource/Guimaraes> ;
    dbo:Country <http://dbpedia.org/resource/Portugal> ;
    excav:hasGPSCoordinates <https://purl.org/megalod/gps/monte-da-penha> .

# Type declarations for referenced resources
<http://dbpedia.org/resource/Braga> a dbo:District .
<http://dbpedia.org/resource/Guimaraes> a dbo:Parish .
<http://dbpedia.org/resource/Portugal> a dbo:Country .

<https://purl.org/megalod/gps/monte-da-penha> a excav:GPSCoordinates ;
    geo:lat "41.4412"^^xsd:decimal ;
    geo:long "-8.2918"^^xsd:decimal .

# =========== ARCHAEOLOGIST ===========

<https://purl.org/megalod/archaeologist/joao-silva> a excav:Archaeologist ;
    foaf:name "Dr. João Silva"^^xsd:literal ;
    foaf:account <https://orcid.org/0000-0003-9876-5432> ;
    foaf:mbox <mailto:joao.silva@archaeology.pt> .

# =========== EXCAVATION SQUARES ===========

<https://purl.org/megalod/square/C1> a excav:Square ;
    dct:identifier "C1"^^xsd:literal ;
    geo:lat "200.75"^^xsd:decimal ;
    geo:long "150.50"^^xsd:decimal .

<https://purl.org/megalod/square/C2> a excav:Square ;
    dct:identifier "C2"^^xsd:literal ;
    geo:lat "201.75"^^xsd:decimal ;
    geo:long "151.50"^^xsd:decimal .

<https://purl.org/megalod/square/D1> a excav:Square ;
    dct:identifier "D1"^^xsd:literal ;
    geo:lat "202.25"^^xsd:decimal ;
    geo:long "152.75"^^xsd:decimal .

# =========== CONTEXTS ===========

<https://purl.org/megalod/context/CTX-101> a excav:Context ;
    dct:identifier "CTX-101"^^xsd:literal ;
    dct:description "Upper occupation layer with scattered lithic tools"^^xsd:literal ;
    excav:hasSVU <https://purl.org/megalod/svu/Layer-01> .

<https://purl.org/megalod/context/CTX-102> a excav:Context ;
    dct:identifier "CTX-102"^^xsd:literal ;
    dct:description "Main occupation layer with dense artifact concentration"^^xsd:literal ;
    excav:hasSVU <https://purl.org/megalod/svu/Layer-02>,
                 <https://purl.org/megalod/svu/Layer-03> .

<https://purl.org/megalod/context/CTX-103> a excav:Context ;
    dct:identifier "CTX-103"^^xsd:literal ;
    dct:description "Lower layer with hearth remains and tools"^^xsd:literal ;
    excav:hasSVU <https://purl.org/megalod/svu/Layer-04> .

# =========== STRATIGRAPHIC VOLUME UNITS ===========

<https://purl.org/megalod/svu/Layer-01> a excav:StratigraphicVolumeUnit ;
    dct:identifier "Layer-01"^^xsd:literal ;
    dct:description "Recent occupation layer with mixed artifacts"^^xsd:literal ;
    excav:hasTimeline <https://purl.org/megalod/timeline/recent-bronze> .

<https://purl.org/megalod/svu/Layer-02> a excav:StratigraphicVolumeUnit ;
    dct:identifier "Layer-02"^^xsd:literal ;
    dct:description "Middle Bronze Age layer with tool production evidence"^^xsd:literal ;
    excav:hasTimeline <https://purl.org/megalod/timeline/middle-bronze> .

<https://purl.org/megalod/svu/Layer-03> a excav:StratigraphicVolumeUnit ;
    dct:identifier "Layer-03"^^xsd:literal ;
    dct:description "Middle Bronze Age continuation with hunting tools"^^xsd:literal ;
    excav:hasTimeline <https://purl.org/megalod/timeline/middle-bronze> .

<https://purl.org/megalod/svu/Layer-04> a excav:StratigraphicVolumeUnit ;
    dct:identifier "Layer-04"^^xsd:literal ;
    dct:description "Early Bronze Age workshop with debitage"^^xsd:literal ;
    excav:hasTimeline <https://purl.org/megalod/timeline/early-bronze-mdp> .

# =========== TIMELINES ===========

<https://purl.org/megalod/timeline/recent-bronze> a excav:TimeLine ;
    time:hasBeginning <https://purl.org/megalod/instant/1300bc> ;
    time:hasEnd <https://purl.org/megalod/instant/1100bc> .

<https://purl.org/megalod/timeline/middle-bronze> a excav:TimeLine ;
    time:hasBeginning <https://purl.org/megalod/instant/1500bc> ;
    time:hasEnd <https://purl.org/megalod/instant/1300bc> .

<https://purl.org/megalod/timeline/early-bronze-mdp> a excav:TimeLine ;
    time:hasBeginning <https://purl.org/megalod/instant/1700bc> ;
    time:hasEnd <https://purl.org/megalod/instant/1500bc> .

# =========== TIME INSTANTS ===========

<https://purl.org/megalod/instant/1700bc> a excav:Instant ;
    excav:bcad <https://purl.org/megalod/kos/MegaLOD-BCAD/BC> ;
    time:inXSDgYear "-1700"^^xsd:gYear .

<https://purl.org/megalod/instant/1500bc> a excav:Instant ;
