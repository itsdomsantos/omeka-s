<http://www.arch-project.com/data/material/flint> a crm:E57_Material;
    rdfs:label "Flint";
    .

<http://www.arch-project.com/data/arrowhead/33> a crm:E24_Physical_Man-Made_Thing;
    dcterms:identifier "33"^^xsd:string;
    ah:shape ah-shape:triangle;
    ah:variant ah-variant:raised;
    crm:P45_consists_of <http://www.arch-project.com/data/material/flint>;
    dbo:Annotation "kahebfakebfja aejfhakjefbhak"^^xsd:string;
    crm:E3_Condition_State true^^xsd:boolean;
    ah:foundInCoordinates <http://www.arch-project.com/data/gps/>;
    ah:hasMorphology <http://www.arch-project.com/data/morphology/>;
    ah:hasTypometry <http://www.arch-project.com/data/typometry/>;
    .

<http://www.arch-project.com/data/morphology/> a ah:Morphology;
    ah:base ah-base:convex;
    ah:point true^^xsd:boolean;
    ah:body "true"^^xsd:boolean;
    .

<http://www.arch-project.com/data/typometry/> a ah:Typometry;
    crm:E54_Dimension "44"^^xsd:decimal, "55"^^xsd:decimal, "4"^^xsd:decimal, "5"^^xsd:decimal, "66"^^xsd:decimal;
    ah:hasChipping <http://www.arch-project.com/data/chipping/>;
    .

<http://www.arch-project.com/data/chipping/> a ah:Chipping;
    ah:mode ah-chippingMode:plane;
    ah:amplitude true^^xsd:boolean;
    ah:direction ah-chippingDirection:reverse;
    ah:orientation true^^xsd:boolean;
    ah:delineation ah-chippingDelineation:composite;
    ah:chippinglocation-Lateral ah-chippingLocation:median;
    ah:chippinglocation-Lateral ah-chippingLocation:distal;
    ah:chippinglocation-Lateral ah-chippingLocation:median;
    ah:chippingLocation-Transversal ah-chippingLocation:distal;
    ah:chippingLocation-Transversal ah-chippingLocation:median;
    ah:chippingLocation-Transversal ah-chippingLocation:distal;
    ah:chippingShape ah-chippingShape:straight;
    .

<http://www.arch-project.com/data/gps/> a geo:SpatialThing;
    geo:lat "3.3"^^xsd:decimal;
    geo:long "4.5"^^xsd:decimal;
    .

