@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmsci: <http://cidoc-crm.org/extensions/crmsci/> .
@prefix crmarchaeo: <http://www.cidoc-crm.org/extensions/crmarchaeo/> .
@prefix edm: <http://www.europeana.eu/schemas/edm/> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix schema: <http://schema.org/> .
@prefix ah: <https://purl.org/megalod/ms/ah/> .
@prefix excav: <https://purl.org/megalod/ms/excavation/> .
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .


# ==========================================================================
# EXCAVATION AND LOCATION CONTEXT
# ==========================================================================

<https://purl.org/megalod/example/excavation/CasteloVelho> a excav:Excavation ;
    dct:identifier "CVH-2025"^^xsd:literal ;
    dul:hasLocation <https://purl.org/megalod/example/location/CasteloVelho> ;
    excav:hasSquare <https://purl.org/megalod/example/square/CV-A1>,
                   <https://purl.org/megalod/example/square/CV-A2> ;
    excav:hasPersonInCharge <https://purl.org/megalod/example/archaeologist/DrSilva> ;
    excav:hasContext <https://purl.org/megalod/example/context/CV-001> .

<https://purl.org/megalod/example/location/CasteloVelho> a excav:Location ;
    dbo:informationName "Castelo Velho Archaeological Site"^^xsd:literal ;
    dbo:country <http://dbpedia.org/resource/Portugal> ;
    dbo:district <http://dbpedia.org/resource/Aveiro_District> ;
    dbo:parish <http://dbpedia.org/resource/Espinho> ;
    excav:hasGPSCoordinates <https://purl.org/megalod/example/gps/CasteloVelho> .

<https://purl.org/megalod/example/gps/CasteloVelho> a excav:GPSCoordinates ;
    geo:lat "40.957761"^^xsd:decimal ;
    geo:long "-8.641111"^^xsd:decimal .

<https://purl.org/megalod/example/archaeologist/DrSilva> a excav:Archaeologist ;
    foaf:account <https://orcid.org/0000-0002-1234-5678> ;
    foaf:name "Dr. Maria Silva"^^xsd:literal ;
    foaf:mbox <mailto:maria.silva@archaeology.pt> .

# ==========================================================================
# STRATIGRAPHIC CONTEXT
# ==========================================================================

<https://purl.org/megalod/example/context/CV-001> a excav:Context ;
    dct:identifier "CV-001"^^xsd:literal ;
    excav:hasSVU <https://purl.org/megalod/example/svu/CV-001-1> .

<https://purl.org/megalod/example/svu/CV-001-1> a excav:StratigraphicVolumeUnit ;
    dct:identifier "CV-001-1"^^xsd:literal ;
    dct:description "Upper archaeological layer with Bronze Age materials"^^xsd:literal ;
    excav:hasTimeline <https://purl.org/megalod/example/timeline/BronzeAge> .

<https://purl.org/megalod/example/timeline/BronzeAge> a excav:TimeLine ;
    time:hasBeginning <https://purl.org/megalod/example/instant/3200BC> ;
    time:hasEnd <https://purl.org/megalod/example/instant/1200BC> .

<https://purl.org/megalod/example/instant/3200BC> a excav:Instant ;
    excav:bcac <https://purl.org/megalod/kos/MegaLOD-BCAC/BC> ;
    time:inXSDgYear "-3200"^^xsd:gYear .

<https://purl.org/megalod/example/instant/1200BC> a excav:Instant ;
    excav:bcac <https://purl.org/megalod/kos/MegaLOD-BCAC/BC> ;
    time:inXSDgYear "-1200"^^xsd:gYear .

# ==========================================================================
# SQUARES
# ==========================================================================

<https://purl.org/megalod/example/square/CV-A1> a excav:Square ;
    dct:identifier "CV-A1"^^xsd:literal ;
    geo:lat "40.957760"^^xsd:decimal ;
    geo:long "-8.641110"^^xsd:decimal .

<https://purl.org/megalod/example/square/CV-A2> a excav:Square ;
    dct:identifier "CV-A2"^^xsd:literal ;
    geo:lat "40.957765"^^xsd:decimal ;
    geo:long "-8.641115"^^xsd:decimal .

# ==========================================================================
# ITEM 1 - Triangular with convex base
# ==========================================================================

<https://purl.org/megalod/example/item/CV-AH-001> a ah:Arrowhead, excav:Item ;
    dct:identifier "CV-AH-001"^^xsd:literal ;  
    ah:shape <https://purl.org/megalod/kos/ah-shape/triangle> ; 
    crm:E55_Type true ; # Elongate type  
    ah:variant <https://purl.org/megalod/kos/ah-variant/flat> ;  
    ah:hasMorphology <https://purl.org/megalod/example/morphology/CV-AH-001> ;  
    ah:hasChipping <https://purl.org/megalod/example/chipping/CV-AH-001> ;  
    ah:hasBodyLength <https://purl.org/megalod/example/typometry/CV-AH-001-hasBodyLength> ;   
    ah:hasBaseLength <https://purl.org/megalod/example/typometry/CV-AH-001-hasBodyLength> ;  
    
    # Item properties (inherited)
    crm:E57_Material <http://collection.britishmuseum.org/id/thesaurus/material/flint> ;  
    crm:E3_Condition_State true ; # Complete  
    schema:height <https://purl.org/megalod/example/typometry/CV-AH-001-height> ;  
    schema:width <https://purl.org/megalod/example/typometry/CV-AH-001-width> ;  
    schema:depth <https://purl.org/megalod/example/typometry/CV-AH-001-thickness> ;  
    schema:weight <https://purl.org/megalod/example/weight/CV-AH-001> ;  
    excav:elongationIndex <https://purl.org/megalod/kos/MegaLOD-IndexElongation/Elongated> ;  
    excav:thicknessIndex <https://purl.org/megalod/kos/MegaLOD-IndexThickness/Thin> ;  
    excav:hasCoordinatesInSquare <https://purl.org/megalod/example/coordinates/CV-AH-001> ;  
    dbo:Annotation "Excellent example of triangular item with fine bifacial working"^^xsd:literal ;  
    excav:foundInSquare <https://purl.org/megalod/example/square/CV-A1> ;  
    dul:hasLocation <https://purl.org/megalod/example/location/CasteloVelho> ;
    edm:Webresource <https://purl.org/megalod/example/images/CV-AH-001-3d.obj> .  

<https://purl.org/megalod/example/morphology/CV-AH-001> a ah:Morphology ;  
    ah:point true ; # Sharp
    ah:body true ; # Symmetrical
    ah:base <https://purl.org/megalod/kos/ah-base/convex> .

<https://purl.org/megalod/example/chipping/CV-AH-001> a ah:Chipping ;
    ah:chippingMode <https://purl.org/megalod/kos/ah-chippingMode/parallel> ;
    ah:chippingAmplitude false ; # Deep
    ah:chippingDirection <https://purl.org/megalod/kos/ah-chippingDirection/bifacial> ;
    ah:chippingOrientation true ; # Lateral
    ah:chippingDelineation <https://purl.org/megalod/kos/ah-chippingDelineation/continuous> ;
    ah:chippingLocationSide <https://purl.org/megalod/kos/ah-chippingLocation/distal>,
                           <https://purl.org/megalod/kos/ah-chippingLocation/median>,
                           <https://purl.org/megalod/kos/ah-chippingLocation/proximal> ;
    ah:chippingLocationTransversal <https://purl.org/megalod/kos/ah-chippingLocation/distal> ;
    ah:chippingShape <https://purl.org/megalod/kos/ah-chippingShape/convex> .

<https://purl.org/megalod/example/typometry/CV-AH-001-hasBodyLength> a excav:TypometryValue ;  
    schema:value "28.5"^^xsd:decimal ;
    schema:UnitCode "MMT"  . # Millimeters


<https://purl.org/megalod/example/typometry/CV-AH-001-hasBodyLength> a excav:TypometryValue ;  
    schema:value "14.2"^^xsd:decimal ;
    schema:UnitCode "MMT" . # Millimeters

<https://purl.org/megalod/example/typometry/CV-AH-001-height> a excav:TypometryValue ;  
    schema:value "32.7"^^xsd:decimal ;
        schema:UnitCode "MMT" . # Millimeters


<https://purl.org/megalod/example/typometry/CV-AH-001-width> a excav:TypometryValue ;
    schema:value "16.3"^^xsd:decimal ;
        schema:UnitCode "MMT" . # Millimeters


<https://purl.org/megalod/example/typometry/CV-AH-001-thickness> a excav:TypometryValue ;
    schema:value "3.2"^^xsd:decimal ;
        schema:UnitCode "MMT" . # Millimeters


<https://purl.org/megalod/example/weight/CV-AH-001> a excav:Weight ;
    schema:value "4.3"^^xsd:decimal ;
    schema:UnitCode "GRM"   .

<https://purl.org/megalod/example/coordinates/CV-AH-001> a excav:Coordinates ;
    geo:longitude <https://purl.org/megalod/example/typometry/CV-AH-001-X> ;
    geo:latitude <https://purl.org/megalod/example/typometry/CV-AH-001-Y> ;
    schema:depth <https://purl.org/megalod/example/typometry/CV-AH-001-depth> .

# X coordinate as TypometryValue
<https://purl.org/megalod/example/typometry/CV-AH-001-X> a excav:TypometryValue ;
    schema:value "10.35"^^xsd:decimal ;
    schema:UnitCode "CMT"   .

# Y coordinate as TypometryValue
<https://purl.org/megalod/example/typometry/CV-AH-001-Y> a excav:TypometryValue ;
    schema:value "10.68"^^xsd:decimal ;
    schema:UnitCode "CMT"   .

# Depth as TypometryValue
<https://purl.org/megalod/example/typometry/CV-AH-001-depth> a excav:TypometryValue ;
    schema:value "45.2"^^xsd:decimal ;
    schema:UnitCode "CMT"   .

<https://purl.org/megalod/example/encounter/CV-AH-001> a excav:EncounterEvent ;
    dct:date "2025-04-12"^^xsd:literal ;
    crmsci:O19_encountered_object <https://purl.org/megalod/example/item/CV-AH-001> ;
    excav:foundInSVU <https://purl.org/megalod/example/svu/CV-001-1> ;
    excav:foundInContext <https://purl.org/megalod/example/context/CV-001> ;
    excav:foundInExcavation <https://purl.org/megalod/example/excavation/CasteloVelho> .

# ==========================================================================
# ITEM 2 - lozenge-shaped with straight base
# ==========================================================================

<https://purl.org/megalod/example/item/CV-AH-002> a ah:Arrowhead, excav:Item ;
    dct:identifier "CV-AH-002"^^xsd:literal ;
    ah:shape <https://purl.org/megalod/kos/ah-shape/lozenge-shaped> ;
    crm:E55_Type false ; # Short type
    ah:variant <https://purl.org/megalod/kos/ah-variant/raised> ;
    ah:hasMorphology <https://purl.org/megalod/example/morphology/CV-AH-002> ;
    ah:hasChipping <https://purl.org/megalod/example/chipping/CV-AH-002> ;
    ah:hasBodyLength <https://purl.org/megalod/example/typometry/CV-AH-002-hasBodyLength> ;
    ah:hasBaseLength <https://purl.org/megalod/example/typometry/CV-AH-002-hasBodyLength> ;
    
    # Item properties (inherited)
    crm:E57_Material <http://collection.britishmuseum.org/id/thesaurus/material/quartz> ;
    crm:E3_Condition_State true ; # Complete
    schema:height <https://purl.org/megalod/example/typometry/CV-AH-002-height> ;
    schema:width <https://purl.org/megalod/example/typometry/CV-AH-002-width> ;
    schema:depth <https://purl.org/megalod/example/typometry/CV-AH-002-thickness> ;
    schema:weight <https://purl.org/megalod/example/weight/CV-AH-002> ;
    excav:elongationIndex <https://purl.org/megalod/kos/MegaLOD-IndexElongation/Medium> ;
    excav:thicknessIndex <https://purl.org/megalod/kos/MegaLOD-IndexThickness/Medium> ;
    excav:hasCoordinatesInSquare <https://purl.org/megalod/example/coordinates/CV-AH-002> ;
    dbo:Annotation "Lozenge-shaped quartz item with distinctive raised profile"^^xsd:literal ;
    excav:foundInSquare <https://purl.org/megalod/example/square/CV-A2> ;
    dul:hasLocation <https://purl.org/megalod/example/location/CasteloVelho> ;
    edm:Webresource <https://purl.org/megalod/example/images/CV-AH-002-1.jpg>,
                    <https://purl.org/megalod/example/images/CV-AH-002-2.jpg> .

<https://purl.org/megalod/example/morphology/CV-AH-002> a ah:Morphology ;
    ah:point true ; # Sharp
    ah:body true ; # Symmetrical
    ah:base <https://purl.org/megalod/kos/ah-base/straight> .

<https://purl.org/megalod/example/chipping/CV-AH-002> a ah:Chipping ;
    ah:chippingMode <https://purl.org/megalod/kos/ah-chippingMode/sub-parallel> ;
    ah:chippingAmplitude true ; # Marginal
    ah:chippingDirection <https://purl.org/megalod/kos/ah-chippingDirection/direct> ;
    ah:chippingOrientation true ; # Lateral
    ah:chippingDelineation <https://purl.org/megalod/kos/ah-chippingDelineation/composite> ;
    ah:chippingLocationSide <https://purl.org/megalod/kos/ah-chippingLocation/distal>,
                           <https://purl.org/megalod/kos/ah-chippingLocation/median> ;
    ah:chippingLocationTransversal <https://purl.org/megalod/kos/ah-chippingLocation/proximal> ;
    ah:chippingShape <https://purl.org/megalod/kos/ah-chippingShape/straight> .

<https://purl.org/megalod/example/typometry/CV-AH-002-hasBodyLength> a excav:TypometryValue ;
    schema:value "21.8"^^xsd:decimal ;
        schema:UnitCode "MMT" . # Millimeters


<https://purl.org/megalod/example/typometry/CV-AH-002-hasBodyLength> a excav:TypometryValue ;
    schema:value "16.5"^^xsd:decimal ;
        schema:UnitCode "MMT" . # Millimeters


<https://purl.org/megalod/example/typometry/CV-AH-002-height> a excav:TypometryValue ;
    schema:value "25.2"^^xsd:decimal ;
        schema:UnitCode "MMT" . # Millimeters


<https://purl.org/megalod/example/typometry/CV-AH-002-width> a excav:TypometryValue ;
    schema:value "16.8"^^xsd:decimal ;
        schema:UnitCode "MMT" . # Millimeters


<https://purl.org/megalod/example/typometry/CV-AH-002-thickness> a excav:TypometryValue ;
    schema:value "5.4"^^xsd:decimal ;
        schema:UnitCode "MMT" . # Millimeters


<https://purl.org/megalod/example/weight/CV-AH-002> a excav:Weight ;
    schema:value "6.8"^^xsd:decimal ;
    schema:UnitCode "GRM"   .

<https://purl.org/megalod/example/coordinates/CV-AH-002> a excav:Coordinates ;
    geo:longitude <https://purl.org/megalod/example/typometry/CV-AH-002-X> ;
    geo:latitude <https://purl.org/megalod/example/typometry/CV-AH-002-Y> ;
    schema:depth <https://purl.org/megalod/example/typometry/CV-AH-002-depth> .

# X coordinate for item 2
<https://purl.org/megalod/example/typometry/CV-AH-002-X> a excav:TypometryValue ;
    schema:value "10.75"^^xsd:decimal ;
    schema:UnitCode "CMT"   .

# Y coordinate for item 2
<https://purl.org/megalod/example/typometry/CV-AH-002-Y> a excav:TypometryValue ;
    schema:value "11.28"^^xsd:decimal ;
    schema:UnitCode "CMT"   .

# Depth for item 2
<https://purl.org/megalod/example/typometry/CV-AH-002-depth> a excav:TypometryValue ;
    schema:value "38.7"^^xsd:decimal ;
    schema:UnitCode "CMT"   .

# Encounter Event for item 2
<https://purl.org/megalod/example/encounter/CV-AH-002> a excav:EncounterEvent ;
    dct:date "2025-04-15"^^xsd:literal ;
    crmsci:O19_encountered_object <https://purl.org/megalod/example/item/CV-AH-002> ;
    excav:foundInSVU <https://purl.org/megalod/example/svu/CV-001-1> ;
    excav:foundInContext <https://purl.org/megalod/example/context/CV-001> ;
    excav:foundInExcavation <https://purl.org/megalod/example/excavation/CasteloVelho> .