@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmsci: <http://cidoc-crm.org/extensions/crmsci/> .
@prefix crmarchaeo: <http://www.cidoc-crm.org/extensions/crmarchaeo/> .
@prefix edm: <http://www.europeana.eu/schemas/edm/> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix schema: <http://schema.org/> .
@prefix ah: <https://purl.org/megalod/ms/ah/> .
@prefix excav: <https://purl.org/megalod/ms/excavation/> .
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .


# ==========================================================================
# EXCAVATION DEFINITION
# ==========================================================================

<https://purl.org/megalod/example/excavation/CasteloVelho> a excav:Excavation ;
    dct:identifier "EXC1"^^xsd:literal ;
    excav:hasPersonInCharge <https://purl.org/megalod/example/archaeologist/JoaoMuralha> ;
    dul:hasLocation <https://purl.org/megalod/example/location/CasteloVelho> ;
    excav:hasSquare <https://purl.org/megalod/example/square/CV-A1>,
                    <https://purl.org/megalod/example/square/CV-A2>,
                    <https://purl.org/megalod/example/square/CV-B1> ;
    excav:hasContext <https://purl.org/megalod/example/context/CV-001>,
                     <https://purl.org/megalod/example/context/CV-002> .

# Location
<http://dbpedia.org/resource/Guarda_District> a dbo:District .
<http://dbpedia.org/resource/Freixo_de_Numão> a dbo:Parish .
<http://dbpedia.org/resource/Portugal> a dbo:Country .

<https://purl.org/megalod/example/location/CasteloVelho> a excav:Location ;
    dbo:informationName "Castelo Velho"^^xsd:literal ;
    dbo:district <http://dbpedia.org/resource/Guarda_District> ;
    dbo:parish <http://dbpedia.org/resource/Freixo_de_Numão> ;
    dbo:country <http://dbpedia.org/resource/Portugal> ;
    excav:hasGPSCoordinates <https://purl.org/megalod/example/gps/CasteloVelho> .

<https://purl.org/megalod/example/gps/CasteloVelho> a excav:GPSCoordinates ;
    geo:lat "41.0578"^^xsd:decimal ;
    geo:long "-7.2233"^^xsd:decimal ;

# Archaeologist
<https://purl.org/megalod/example/archaeologist/JoaoMuralha> a excav:Archaeologist ;
    foaf:name "João Muralha"^^xsd:literal ;
    foaf:account <https://orcid.org/0000-0002-1234-5678> ;
    foaf:mbox <mailto:joao.muralha@example.org> .

# Squares
<https://purl.org/megalod/example/square/CV-A1> a excav:Square ;
    dct:identifier "A1"^^xsd:literal ;
    geo:long 10.0 ;
    geo:lat 10.0 .

<https://purl.org/megalod/example/square/CV-A2> a excav:Square ;
    dct:identifier "A2"^^xsd:literal ;
    geo:long 10.0 ;
    geo:lat 11.0 .

<https://purl.org/megalod/example/square/CV-B1> a excav:Square ;
    dct:identifier "B1"^^xsd:literal ;
    geo:long 11.0 ;
    geo:lat 10.0 .

# Contexts and Stratigraphic Units
<https://purl.org/megalod/example/context/CV-001> a excav:Context ;
    dct:identifier "CV-001"^^xsd:literal ;
    excav:hasSVU <https://purl.org/megalod/example/svu/CV-001-1>,
                 <https://purl.org/megalod/example/svu/CV-001-2> .

<https://purl.org/megalod/example/context/CV-002> a excav:Context ;
    dct:identifier "CV-002"^^xsd:literal ;
    excav:hasSVU <https://purl.org/megalod/example/svu/CV-002-1> .

<https://purl.org/megalod/example/svu/CV-001-1> a excav:StratigraphicVolumeUnit ;
    dct:identifier "CV-001-1"^^xsd:literal ;
    dct:description "Upper layer with early chalcolithic artifacts"^^xsd:literal ;
    excav:hasTimeline <https://purl.org/megalod/example/timeline/CV-001-1> .

<https://purl.org/megalod/example/svu/CV-001-2> a excav:StratigraphicVolumeUnit ;
    dct:identifier "CV-001-2"^^xsd:literal ;
    dct:description "Middle layer with late neolithic artifacts"^^xsd:literal ;
    excav:hasTimeline <https://purl.org/megalod/example/timeline/CV-001-2> .

<https://purl.org/megalod/example/svu/CV-002-1> a excav:StratigraphicVolumeUnit ;
    dct:identifier "CV-002-1"^^xsd:literal ;
    dct:description "Lower layer with mid neolithic artifacts"^^xsd:literal ;
    excav:hasTimeline <https://purl.org/megalod/example/timeline/CV-002-1> .

# Timelines
<https://purl.org/megalod/example/timeline/CV-001-1> a excav:TimeLine ;
    time:hasBeginning <https://purl.org/megalod/example/instant/CV-001-1-begin> ;
    time:hasEnd <https://purl.org/megalod/example/instant/CV-001-1-end> .

<https://purl.org/megalod/example/timeline/CV-001-2> a excav:TimeLine ;
    time:hasBeginning <https://purl.org/megalod/example/instant/CV-001-2-begin> ;
    time:hasEnd <https://purl.org/megalod/example/instant/CV-001-2-end> .

<https://purl.org/megalod/example/timeline/CV-002-1> a excav:TimeLine ;
    time:hasBeginning <https://purl.org/megalod/example/instant/CV-002-1-begin> ;
    time:hasEnd <https://purl.org/megalod/example/instant/CV-002-1-end> .

<https://purl.org/megalod/example/instant/CV-001-1-begin> a excav:Instant ;
    excav:bcac <https://purl.org/megalod/kos/MegaLOD-BCAC/BC> ;
    time:inXSDgYear "-3200"^^xsd:gYear .

<https://purl.org/megalod/example/instant/CV-001-1-end> a excav:Instant ;
    excav:bcac <https://purl.org/megalod/kos/MegaLOD-BCAC/BC> ;
    time:inXSDgYear "2800"^^xsd:gYear .

<https://purl.org/megalod/example/instant/CV-001-2-begin> a excav:Instant ;
    excav:bcac <https://purl.org/megalod/kos/MegaLOD-BCAC/BC> ;
    time:inXSDgYear "3600"^^xsd:gYear .

<https://purl.org/megalod/example/instant/CV-001-2-end> a excav:Instant ;
    excav:bcac <https://purl.org/megalod/kos/MegaLOD-BCAC/BC> ;
    time:inXSDgYear "-3200"^^xsd:gYear .

<https://purl.org/megalod/example/instant/CV-002-1-begin> a excav:Instant ;
    excav:bcac <https://purl.org/megalod/kos/MegaLOD-BCAC/BC> ;
    time:inXSDgYear "4000"^^xsd:gYear .

<https://purl.org/megalod/example/instant/CV-002-1-end> a excav:Instant ;
    excav:bcac <https://purl.org/megalod/kos/MegaLOD-BCAC/BC> ;
    time:inXSDgYear "3600"^^xsd:gYear .