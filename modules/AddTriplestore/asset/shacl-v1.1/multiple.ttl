    excav:foundInLocation <https://purl.org/megalod/example/location/monte-alto> ;
    schema:height <https://purl.org/megalod/example/typometry/AH-001-01-height> ;
    schema:width <https://purl.org/megalod/example/typometry/AH-001-01-width> ;
    schema:depth <https://purl.org/megalod/example/typometry/AH-001-01-thickness> ;
    schema:weight <https://purl.org/megalod/example/weight/AH-001-01> ;
