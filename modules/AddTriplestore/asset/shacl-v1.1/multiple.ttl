    ah:hasBaseLength <https://purl.org/megalod/example/typometry/AH-001-01-baseLength> ;
    excav:elongationIndex <https://purl.org/megalod/kos/MegaLOD-IndexElongation/Elongated> ;
    excav:thicknessIndex <https://purl.org/megalod/kos/MegaLOD-IndexThickness/Thin> ;
    ah:hasMorphology <https://purl.org/megalod/example/morphology/AH-001-01> ;
    ah:hasChipping <https://purl.org/megalod/example/chipping/AH-001-01> ;
    excav:hasCoordinatesInSquare <https://purl.org/megalod/example/coordinates/AH-001-01> ;
    excav:wasEncounteredIn <https://purl.org/megalod/example/encounter/AH-001-01> .

<https://purl.org/megalod/example/typometry/AH-001-01-height> a excav:TypometryValue ;
    schema:value "32.5"^^xsd:decimal ;
    schema:UnitCode <MMT> .

<https://purl.org/megalod/example/typometry/AH-001-01-width> a excav:TypometryValue ;
    schema:value "18.2"^^xsd:decimal ;
    schema:UnitCode <MMT> .

<https://purl.org/megalod/example/typometry/AH-001-01-thickness> a excav:TypometryValue ;
    schema:value "4.1"^^xsd:decimal ;
    schema:UnitCode <MMT> .

<https://purl.org/megalod/example/weight/AH-001-01> a excav:Weight ;
    schema:value "5.2"^^xsd:decimal ;
    schema:UnitCode <GRM> .

<https://purl.org/megalod/example/typometry/AH-001-01-bodyLength> a excav:TypometryValue ;
    schema:value "26.8"^^xsd:decimal ;
    schema:UnitCode <MMT> .

<https://purl.org/megalod/example/typometry/AH-001-01-baseLength> a excav:TypometryValue ;
    schema:value "13.5"^^xsd:decimal ;
    schema:UnitCode <MMT> .

<https://purl.org/megalod/example/morphology/AH-001-01> a ah:Morphology ;
    ah:point "true"^^xsd:boolean ;
    ah:body "true"^^xsd:boolean ;
    ah:base <https://purl.org/megalod/kos/ah-base/convex> .

<https://purl.org/megalod/example/chipping/AH-001-01> a ah:Chipping ;
    ah:chippingMode <https://purl.org/megalod/kos/ah-chippingMode/parallel> ;
    ah:chippingAmplitude "false"^^xsd:boolean ;
    ah:chippingDirection <https://purl.org/megalod/kos/ah-chippingDirection/bifacial> ;
    ah:chippingOrientation "true"^^xsd:boolean ;
    ah:chippingDelineation <https://purl.org/megalod/kos/ah-chippingDelineation/continuous> ;
    ah:chippingLocationSide <https://purl.org/megalod/kos/ah-chippingLocation/distal> ;
    ah:chippingLocationTransversal <https://purl.org/megalod/kos/ah-chippingLocation/median> ;
    ah:chippingShape <https://purl.org/megalod/kos/ah-chippingShape/convex> .

<https://purl.org/megalod/example/coordinates/AH-001-01> a excav:Coordinates ;
    schema:value "15.3 CMT"^^xsd:literal ;
    schema:value "22.7 CMT"^^xsd:literal ;
    schema:value "18.5 CMT"^^xsd:literal .

<https://purl.org/megalod/example/encounter/AH-001-01> a excav:EncounterEvent ;
    dct:date "2025-03-15"^^xsd:literal ;
    crmsci:O19_encountered_object <https://purl.org/megalod/example/item/AH-001-01> ;
    excav:foundInExcavation <https://purl.org/megalod/example/excavation/EXC-001> ;
    excav:foundInContext <https://purl.org/megalod/example/context/CTX-001> ;
    excav:foundInSVU <https://purl.org/megalod/example/svu/SVU-001-1> ;
    dbo:depth "32.8"^^xsd:decimal .

