                foreach ($relatedItems as $item) {
                    // Check if this item is an arrowhead (you may need to adjust this condition based on your data model)
                    $isArrowhead = false;
                    
                    // Method 1: Check by resource class if you have a class for arrowheads
                    $resourceClass = $item->resourceClass();
                    if ($resourceClass && $resourceClass->term() === 'ah:Arrowhead') {
                        $isArrowhead = true;
                    }
                    
                    // Method 2: Check by resource template if you use templates to distinguish arrowheads
                    $resourceTemplate = $item->resourceTemplate();
                    if ($resourceTemplate && 
                        (strpos(strtolower($resourceTemplate->label()), 'arrowhead') !== false)) {
                        $isArrowhead = true;
                    }
                    
                    // Method 3: Check by title or specific property that identifies arrowheads
                    $title = strtolower($item->displayTitle());
                    if (strpos($title, 'arrowhead') !== false || 
                        strpos($title, 'arrow head') !== false ||
                        strpos($title, 'point') !== false) {
                        $isArrowhead = true;
                    }
                    
                    if ($isArrowhead) {
                        $arrowheadItems[] = $item;
                    }
                }
            }
            
            $itemCount = count($arrowheadItems);
