                                    // Extract location data from item set values
                                    $values = $itemSet->values();
                                    $locationParts = [];
                                    $gpsCoords = null;
                                    
                                    // Look for location-related properties
                                    foreach ($values as $term => $propertyValues) {
                                        if (!empty($propertyValues) && isset($propertyValues[0]) && $propertyValues[0]->property()) {
                                            $propertyLabel = $propertyValues[0]->property()->label();
                                            $value = $propertyValues[0]->value();
                                            
                                            // Check for different location properties
                                            if (stripos($propertyLabel, 'parish') !== false) {
                                                $locationParts['parish'] = $value;
                                            } elseif (stripos($propertyLabel, 'district') !== false) {
                                                $locationParts['district'] = $value;
                                            } elseif (stripos($propertyLabel, 'country') !== false) {
                                                $locationParts['country'] = $value;
                                            } elseif (stripos($propertyLabel, 'location') !== false && stripos($propertyLabel, 'gps') === false) {
                                                $locationParts['site'] = $value;
                                            } elseif (stripos($propertyLabel, 'gps') !== false || stripos($propertyLabel, 'coordinates') !== false) {
                                                $gpsCoords = $value;
                                            }
                                        }
                                    }
                                    
                                    // Display location information
                                    if (!empty($locationParts) || $gpsCoords): ?>
                                        <div class="location-details">
                                            <span class="location-icon">📍</span>
                                            <div class="location-text">
                                                <?php
                                                // Create a nice location string
                                                $displayLocation = [];
                                                
                                                if (isset($locationParts['site'])) {
                                                    $displayLocation[] = $locationParts['site'];
                                                }
                                                if (isset($locationParts['parish'])) {
                                                    $displayLocation[] = $locationParts['parish'];
                                                }
                                                if (isset($locationParts['district'])) {
                                                    $displayLocation[] = $locationParts['district'];
                                                }
                                                if (isset($locationParts['country'])) {
                                                    $displayLocation[] = $locationParts['country'];
                                                }
                                                
                                                if (!empty($displayLocation)) {
                                                    echo '<div class="location-address">' . $this->escapeHtml(implode(', ', array_slice($displayLocation, 0, 2))) . '</div>';
                                                    if (count($displayLocation) > 2) {
                                                        echo '<div class="location-region">' . $this->escapeHtml(implode(', ', array_slice($displayLocation, 2))) . '</div>';
                                                    }
                                                }
                                                
                                                if ($gpsCoords): ?>
                                                    <div class="gps-coords"><?php echo $this->escapeHtml($gpsCoords); ?></div>
                                                <?php endif; ?>
                                            </div>
                                        </div>
                                    <?php endif; ?>
                                </div>
                                
                                <!-- Additional metadata -->
                                <div class="excavation-metadata">
